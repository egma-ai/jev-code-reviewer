{
  "name": "jev-reviewer",
  "version": "0.1.0",
  "description": "A human-first GitHub review interface, prioritized by Jev and explained by OpenAI.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-reviewer": "bin/jev-reviewer.mjs"
